# Environment Configuration for Smart Temperature & Humidity Monitor
# Copy this file to .env and configure your settings

# Web Server Configuration
WEB_SERVER_ENABLED=true
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=5000

# Display Configuration
DISPLAY_PAGE_ROTATION_ENABLED=true
DISPLAY_PAGE_ROTATION_INTERVAL=10

# Sensor Configuration
REFRESH_SECONDS=10

# Data Export Configuration
EXPORT_ENABLED=false
EXPORT_WEBHOOK_URL=https://your-webhook-url.com/api/data
EXPORT_API_KEY=your-api-key-here
EXPORT_WEBHOOK_ENABLED=false

# Google Sheets Configuration (Optional)
# GOOGLE_SHEETS_ENABLED=false
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
# GOOGLE_CREDENTIALS_FILE=credentials.json

# MQTT Configuration (Optional - for home automation)
# MQTT_ENABLED=false
# MQTT_BROKER=localhost
# MQTT_PORT=1883
# MQTT_TOPIC=home/environmental
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Backup Configuration
LOCAL_BACKUP_ENABLED=true
LOCAL_BACKUP_DIR=data/backup

JSON_EXPORT_ENABLED=true
JSON_EXPORT_DIR=data/json

# Alerting (Optional - requires additional setup)
# ALERT_EMAIL_ENABLED=false
# ALERT_EMAIL_TO=your-email@example.com
# ALERT_EMAIL_FROM=monitor@yourdomain.com
# ALERT_TEMP_HIGH=30
# ALERT_TEMP_LOW=15
# ALERT_HUMIDITY_HIGH=70
# ALERT_HUMIDITY_LOW=30
